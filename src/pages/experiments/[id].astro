---
// One template that makes a page for every visible experiment.
// The Markdown body can use a few layout classes (see the styles below):
// .hook, .fig (+ .pair / .grid4), .kind, .jump, .glance, .calls, .steps,
// details.tech, .pipe, .broke, .quote, .who.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperimentTag from '../../components/ExperimentTag.astro';
import { getDrawer, isReady } from '../../data/drawers';
import { expNumber, getVisibleExperiments } from '../../lib/experiments';

export async function getStaticPaths() {
  const experiments = await getVisibleExperiments();
  return experiments.map((exp) => ({
    params: { id: exp.id },
    props: { exp },
  }));
}

const { exp } = Astro.props;
const { Content } = await render(exp);
const drawer = getDrawer(exp.data.drawer)!;
---
<BaseLayout title={exp.data.title} description={exp.data.summary} drawer={exp.data.drawer} onDrawerPage={false}>
  <article>
    <p class="crumb label"><a href={drawer.href}>{drawer.label}</a> / {expNumber(exp.data.number)}</p>
    <h1>{exp.data.title}</h1>
    <ExperimentTag data={exp.data} />

    {exp.data.files && (
      <aside class="files">
        {exp.data.files.map((file) => (
          <p>
            <a href={file.href}>{file.label}</a>
            {file.note && <span class="note">{file.note}</span>}
          </p>
        ))}
      </aside>
    )}

    <div class="body">
      <Content />
    </div>

    {exp.data.concepts.length > 0 && (
      <div class="concepts">
        {exp.data.concepts.map((c) => <span class="chip">{c}</span>)}
      </div>
    )}

    <nav class="pager label" aria-label="More">
      <a href={drawer.href}>← Back to<b>{drawer.label}</b></a>
      {isReady('about') && <a class="end" href="/about/">About →<b>Mad Seacow</b></a>}
    </nav>
  </article>
</BaseLayout>

<style>
  article {
    min-width: 0;
  }
  .crumb {
    color: var(--soft);
    margin: 0 0 0.6rem;
  }
  .crumb a {
    color: var(--soft);
  }
  .crumb a:hover {
    color: var(--on-hazard);
  }
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    max-width: 42rem;
  }
  article > :global(.tag) {
    max-width: 42rem;
  }
  .files {
    max-width: 42rem;
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    background: var(--raised);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--folder);
    border-radius: 2px;
  }
  .files p {
    margin: 0.25rem 0;
  }
  .note {
    display: block;
    color: var(--soft);
  }

  /* ---------- Body text: about 42rem wide; images can use the full column ---------- */
  .body :global(:is(p, ul, ol, h3, .steps, .calls, details, blockquote)) {
    max-width: 42rem;
  }
  .body :global(p) {
    margin: 0 0 1rem;
    line-height: 1.65;
  }
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
  }
  .body :global(li) {
    margin: 0 0 0.45rem;
    line-height: 1.55;
  }
  .body :global(h2) {
    font-size: 1.45rem;
    margin: 3.2rem 0 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .body :global(h3) {
    font-size: 1.1rem;
    margin: 1.6rem 0 0.5rem;
  }
  .body :global(h2 + h3) {
    margin-top: 0;
  }
  .body :global(.hook) {
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 1.2rem;
  }

  /* ---------- Figures: every image carries a type tag in its caption ---------- */
  .body :global(.fig) {
    margin: 1.8rem 0 1.4rem;
  }
  .body :global(.fig img),
  .body :global(.fig video) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: #000;
  }
  .body :global(.fig figcaption) {
    font-family: var(--type);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--soft);
    margin-top: 0.5rem;
  }
  .body :global(.kind) {
    display: inline-block;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--steel-hi);
    color: var(--text);
    padding: 0.1rem 0.4rem;
    margin-right: 0.45rem;
    border-radius: 2px;
  }
  /* image grids: a 2×2 for the day, side-by-side pairs */
  .body :global(.fig.grid4),
  .body :global(.fig.pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .body :global(.fig.grid4 > div),
  .body :global(.fig.pair > div) {
    position: relative;
    min-width: 0;
  }
  .body :global(.fig.grid4 figcaption),
  .body :global(.fig.pair figcaption) {
    grid-column: 1 / -1;
    margin-top: 0;
  }
  .body :global(.fig .label) {
    position: absolute;
    left: 0.45rem;
    top: 0.45rem;
    background: var(--bg);
    color: var(--text);
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
    font-size: 0.6rem;
  }
  @media (max-width: 30rem) {
    .body :global(.fig.pair) {
      grid-template-columns: 1fr;
    }
  }

  /* the jump link under the photo, and where it lands */
  .body :global(.jump) {
    margin: -0.6rem 0 0;
    font-family: var(--type);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .body :global(#refresh) {
    scroll-margin-top: 1.5rem;
  }

  /* ---------- At a glance: plain rows with rules, no box ---------- */
  .body :global(.glance) {
    max-width: 42rem;
    margin: 2.2rem 0 0;
    padding: 1.2rem 0;
    border-top: 2px solid var(--text);
    border-bottom: 1px solid var(--rule);
  }
  .body :global(.glance h2) {
    margin: 0 0 0.8rem;
    padding: 0;
    border: 0;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--soft);
  }
  .body :global(.glance dl) {
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .body :global(.glance dl > div) {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
  }
  .body :global(.glance dt) {
    font-family: var(--type);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
    padding-top: 0.25rem;
  }
  .body :global(.glance dd) {
    margin: 0;
    line-height: 1.5;
  }
  .body :global(.glance .own) {
    margin: 1rem 0 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--text);
    line-height: 1.55;
  }
  @media (max-width: 40rem) {
    .body :global(.glance dl > div) {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  /* ---------- Intentional choices: square markers ---------- */
  .body :global(.calls ul) {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .body :global(.calls li) {
    position: relative;
    padding-left: 1.1rem;
    margin: 0;
    line-height: 1.6;
  }
  .body :global(.calls li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--text);
  }

  /* ---------- Numbered steps ---------- */
  .body :global(.steps ol) {
    list-style: none;
    counter-reset: st;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }
  .body :global(.steps li) {
    counter-increment: st;
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    margin: 0;
    line-height: 1.5;
  }
  .body :global(.steps li::before) {
    content: counter(st, decimal-leading-zero);
    font-family: var(--type);
    font-size: 0.75rem;
    color: var(--soft);
  }

  /* ---------- Pillow → EPDOptimize → driver ---------- */
  .body :global(ol.pipe) {
    list-style: none;
    padding: 0;
    margin: 0 0 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 1rem;
  }
  .body :global(ol.pipe li) {
    margin: 0;
  }
  .body :global(ol.pipe li:not(:last-child)::after) {
    content: '→';
    margin-left: 0.9rem;
    color: var(--soft);
    font-family: var(--type);
  }

  /* ---------- Technical notes: collapsible, ruled, no box ---------- */
  .body :global(details.tech) {
    margin: 0.4rem 0 1.4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .body :global(details.tech summary) {
    cursor: pointer;
    list-style: none;
    padding: 0.75rem 0;
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
  }
  .body :global(details.tech summary::-webkit-details-marker) {
    display: none;
  }
  .body :global(details.tech summary::after) {
    content: '+';
    margin-left: auto;
    font-family: var(--type);
    color: var(--soft);
  }
  .body :global(details.tech[open] summary::after) {
    content: '–';
  }
  .body :global(details.tech summary .label) {
    color: var(--soft);
  }
  .body :global(details.tech ul) {
    margin-bottom: 0.9rem;
  }

  /* ---------- Tables ---------- */
  .body :global(table) {
    width: 100%;
    max-width: 42rem;
    border-collapse: collapse;
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }
  .body :global(th) {
    font-family: var(--type);
    font-weight: 400;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
    text-align: left;
    padding: 0.4rem 0.8rem 0.4rem 0;
    border-bottom: 1px solid var(--soft);
  }
  .body :global(td) {
    padding: 0.6rem 0.8rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: 1.45;
  }
  .body :global(td:first-child) {
    font-weight: 600;
  }
  .body :global(.broke table) {
    max-width: none;
  }
  .body :global(.broke th) {
    border-bottom: 2px solid var(--text);
  }
  /* on a phone, What broke stacks each row: symptom, then cause and fix */
  @media (max-width: 40rem) {
    .body :global(.broke thead) {
      display: none;
    }
    .body :global(.broke tr) {
      display: grid;
      gap: 0.2rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .body :global(.broke td) {
      border: 0;
      padding: 0;
    }
    .body :global(.broke td:nth-child(2)::before) {
      content: 'Cause: ';
      color: var(--soft);
    }
    .body :global(.broke td:nth-child(3)::before) {
      content: 'Fix: ';
      color: var(--soft);
    }
  }

  /* ---------- Pull quote ---------- */
  .body :global(.quote) {
    margin: 2rem 0 1.2rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .body :global(.quote p) {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.3;
    font-weight: 600;
  }

  /* ---------- Who did what: three columns, no boxes ---------- */
  .body :global(.who) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
  }
  .body :global(.who h3) {
    margin: 0 0 0.4rem;
    color: var(--soft);
    font-weight: 400;
  }
  .body :global(.who p) {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }
  @media (max-width: 52rem) {
    .body :global(.who) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* ---------- Bottom ---------- */
  .concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .pager a {
    background: none;
    color: var(--soft);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.8rem 1rem;
  }
  .pager a:hover {
    color: var(--text);
    border-color: var(--soft);
  }
  .pager .end {
    text-align: right;
  }
  .pager b {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--serif);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text);
  }
</style>
