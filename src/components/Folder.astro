---
// One experiment in a drawer list: a tan folder back and tab behind a clean dark row.
// With no experiment it's an empty "Not filed" folder: dashed and muted.
import { expNumber, type Experiment } from '../lib/experiments';

interface Props {
  exp?: Experiment;
  titleLevel?: 'h2' | 'h3';
}
const { exp, titleLevel = 'h2' } = Astro.props;
const Title = titleLevel;
const data = exp?.data;
const dev = import.meta.env.DEV;
const year = data?.date?.getFullYear();
const meta = [data?.type, year].filter(Boolean).join(' · ');
---
{data ? (
  <li class:list={['file', { 'has-snap': data.thumb }]}>
    <a href={`/experiments/${exp!.id}/`}>
      <span class="tab label">{expNumber(data.number)}</span>
      <div class="body">
        {data.thumb && (
          <span class="snap" aria-hidden="true">
            <img src={data.thumb} width="560" height="408" loading="lazy" decoding="async" alt="" />
            <svg class="clip" viewBox="0 0 14 36" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <path d="M9 10V27a2.5 2.5 0 0 1-5 0V6a4 4 0 0 1 8 0v22a5.5 5.5 0 0 1-11 0V12" />
            </svg>
          </span>
        )}
        <div>
          <Title class="title">{data.title}</Title>
          {data.summary ? <p class="line">{data.summary}</p> : dev && <p class="line ph">[Summary: not in frontmatter yet]</p>}
          {data.description ? (
            <p class="desc">{data.description}</p>
          ) : (
            dev && <p class="desc ph">[Description: not in frontmatter yet]</p>
          )}
        </div>
        <div class="side">
          {data.draft && <span class="draft label">Draft</span>}
          {data.case_status && <span class="stamp">{data.case_status}</span>}
          {meta && <span class="meta label">{meta}</span>}
        </div>
        <div class="chips">
          {data.concepts.map((c) => <span class="chip">{c}</span>)}
          <span class="open">Open file →</span>
        </div>
      </div>
    </a>
  </li>
) : (
  <li class="file later">
    <span class="tab label">Not filed</span>
    <div class="body"><p class="pending">Experiments in progress. Write-ups coming.</p></div>
  </li>
)}

<style>
  .file {
    position: relative;
    padding-top: 1.35rem;
  }
  .file > a {
    display: block;
    background: none;
    color: inherit;
  }
  .file > a:hover {
    color: inherit;
  }
  .file > a:focus-visible {
    outline: none;
  }

  /* the tab, and the back of the folder showing as a strip behind the row */
  .tab {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 1rem;
    height: 1.45rem;
    padding: 0.14rem 0.75rem 0;
    background: var(--folder);
    color: var(--on-folder);
    border: 1px solid var(--folder-edge);
    border-bottom: 0;
    border-radius: 2px 2px 0 0;
    font-size: 0.68rem;
  }
  .file::before {
    content: '';
    position: absolute;
    z-index: 0;
    left: 0;
    right: 0;
    top: 1.3rem;
    height: 2.5rem;
    background: var(--folder);
    border: 1px solid var(--folder-edge);
    border-bottom: 0;
    border-radius: 0 2px 0 0;
  }

  .body {
    position: relative;
    z-index: 2;
    margin-top: 0.55rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1.5rem;
    padding: 1.05rem 1.2rem 1.15rem;
    background: var(--raised);
    border: 1px solid var(--rule);
    border-top-color: #4a463f;
    border-radius: 0 2px 2px 2px;
  }
  .title {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .line {
    margin: 0;
    font-size: 1rem;
  }
  .desc {
    margin: 0.45rem 0 0;
    font-size: 0.95rem;
    color: var(--soft);
  }
  /* snapshot: a small photo print clipped to the folder (DESIGN.md, Folders) */
  .has-snap .body {
    grid-template-columns: auto 1fr auto;
  }
  .has-snap .chips {
    grid-column: 2 / -1;
  }
  .snap {
    position: relative;
    grid-row: 1;
    align-self: start;
    width: 9rem;
    margin-top: -1.45rem; /* top edge pokes just above the card */
    padding: 3px;
    background: var(--text);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
    transform: rotate(-1.5deg);
  }
  .snap img {
    width: 100%;
    aspect-ratio: 560 / 408;
    object-fit: cover;
  }
  .clip {
    position: absolute;
    top: -1.05rem;
    right: 1.4rem;
    width: 0.8rem;
    height: 2.05rem;
    color: var(--text);
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.6));
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.55rem;
    text-align: right;
  }
  .meta {
    color: var(--soft);
  }
  .draft {
    border: 2px dashed var(--text);
    padding: 0 0.4em;
    font-size: 0.68rem;
  }
  .chips {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }
  .open {
    margin-left: auto;
    font-family: var(--type);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
  }

  /* hover or keyboard focus: the folder lifts up out of the drawer */
  .file:not(.later):hover::before,
  .file:focus-within::before,
  .file:not(.later):hover .tab,
  .file:focus-within .tab {
    transform: translateY(-6px);
  }
  /* the snapshot is clipped to the folder, so it rises the same 6px as the back
     (5px here plus the row's own 1px) */
  .file > a:hover .snap,
  .file:focus-within .snap {
    transform: translateY(-5px) rotate(-1.5deg);
  }
  .file > a:hover .body,
  .file > a:focus-visible .body {
    transform: translateY(-1px);
    box-shadow: 0 14px 24px rgba(0, 0, 0, 0.5);
    border-color: #5a554c;
  }
  .file > a:hover .open {
    color: var(--hazard);
  }
  .file > a:focus-visible .body {
    outline: 3px solid var(--hazard);
    outline-offset: 2px;
  }

  /* not filed yet: dashed and muted */
  .later .tab {
    background: transparent;
    border: 1px dashed var(--soft);
    border-bottom: 0;
    color: var(--soft);
  }
  .later::before {
    background: transparent;
    border: 1px dashed var(--soft);
    border-bottom: 0;
  }
  .pending {
    margin: 0;
    color: var(--soft);
    font-size: 1rem;
  }
  .later .body {
    min-height: 3.5rem;
    background: var(--bg);
    border: 1px dashed var(--rule);
    border-top: 1px dashed var(--soft);
  }

  @media (max-width: 40rem) {
    .body,
    .has-snap .body {
      grid-template-columns: 1fr;
    }
    /* phone: tabs and titles only, so no snapshot */
    .snap {
      display: none;
    }
    .has-snap .chips {
      grid-column: 1 / -1;
    }
    .side {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      text-align: left;
    }
    .side:empty {
      display: none;
    }
  }
</style>
