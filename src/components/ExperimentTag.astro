---
// The experiment tag: Status · Type · Year · What I learned, typed like a lab label.
// Empty fields show a dash instead of inventing anything.
import type { Experiment } from '../lib/experiments';

interface Props {
  data: Experiment['data'];
}
const { data } = Astro.props;
const blank = '—';
---
<dl class="tag label">
  {data.draft && <div class="draft"><dt>Draft</dt><dd>Not live</dd></div>}
  <div><dt>Status</dt><dd>{data.case_status ? <span class="stamp">{data.case_status}</span> : blank}</dd></div>
  <div><dt>Type</dt><dd>{data.type ?? blank}</dd></div>
  <div><dt>Year</dt><dd>{data.date?.getFullYear() ?? blank}</dd></div>
  <div class="wide"><dt>What I learned</dt><dd>{data.lesson ?? blank}</dd></div>
</dl>

<style>
  .tag {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0 0 1.75rem;
    padding: 1rem 0;
    border-top: 2px solid var(--text);
    border-bottom: 1px solid var(--rule);
  }
  .wide {
    grid-column: 1 / -1;
  }
  dt {
    color: var(--soft);
    font-size: 0.68rem;
  }
  dd {
    margin: 0.25rem 0 0;
    font-family: var(--serif);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .draft dd {
    display: inline-block;
    border: 2px dashed var(--text);
    padding: 0 0.4em;
    font-family: var(--type);
    text-transform: uppercase;
  }
</style>
